# Copy to examples/.env and fill in. examples/.env is git-ignored.
#   cp examples/.env.example examples/.env
# The example scripts auto-load examples/.env at startup (no extra deps).

# --- Agent model (pick the provider you configure in the example) ---
OPENAI_API_KEY=

# --- Sandbox (E2B cloud isolation): pip install 'vel-ai[sandbox-e2b]' ---
E2B_API_KEY=

# --- Web search tool (choose your backend) ---
# Recommended for an agentic research assistant (returns sources to read):
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Alternative answer-engine (pre-synthesized answers + citations):
PERPLEXITY_API_KEY=

# --- Slack channel adapter: pip install 'vel-ai[channels-slack]' ---
# Bot token (xoxb-...) and signing secret from your Slack app config.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Optional: durable multi-worker backends ---
# VEL_PG_DSN=postgresql://user:pass@localhost:5432/vel
# VEL_REDIS_URL=redis://localhost:6379
